{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public && echo hoggy > public/_build.txt",
  "outputDirectory": "public",
  "regions": [
    "syd1"
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,app.js,styles.css,admin.html,admin.js,parse.js,pack.js,stats.js,courses.js,data/**,lib/**,db/**,icons/**,tools/evidence.js,tools/official-domains.json,tools/copy-lint.js,node_modules/pdfjs-dist/legacy/build/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ]
}
