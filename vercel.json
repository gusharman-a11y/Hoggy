{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "mkdir -p public && printf 'User-agent: *\nAllow: /\n' > public/robots.txt",
  "outputDirectory": "public",
  "functions": {
    "api/index.js": {
      "includeFiles": "{index.html,app.js,styles.css,admin.html,admin.js,parse.js,pack.js,data/**,lib/**,node_modules/pdfjs-dist/legacy/build/**}",
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }]
}
